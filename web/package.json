		"lucide-svelte": "^1.0.1",
		"maplibre-gl": "^5.24.0",
		"motion": "^12.42.2",
		"pdf-lib": "^1.17.1",
		"pdfkit": "^0.20.1",
		"postgres": "^3.4.9",
		"qrcode": "^1.5.4",
		"svg-to-pdfkit": "^0.1.8"
	}
