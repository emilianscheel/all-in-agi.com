      "checkConstraints": {
        "hackathons_id_format_check": {
          "name": "hackathons_id_format_check",
          "value": "\"hackathons\".\"id\" ~ '^H[A-Z0-9]{2}-[A-Z0-9]{3}-[A-Z0-9]{3}$'"
        },
        "hackathons_customer_locale_check": {
          "name": "hackathons_customer_locale_check",
          "value": "\"hackathons\".\"customer_locale\" in ('de', 'en')"
        },
        "hackathons_capacity_check": {
          "name": "hackathons_capacity_check",
          "value": "\"hackathons\".\"capacity\" in (15, 30, 50)"
        },
        "hackathons_device_provision_check": {
          "name": "hackathons_device_provision_check",
          "value": "\"hackathons\".\"device_provision\" in ('existing', 'needed')"
        },
        "hackathons_device_count_check": {
          "name": "hackathons_device_count_check",
          "value": "(\"hackathons\".\"device_provision\" = 'existing' and \"hackathons\".\"device_count\" = 0) or (\"hackathons\".\"device_provision\" = 'needed' and \"hackathons\".\"device_count\" between 1 and \"hackathons\".\"capacity\")"
        },
        "hackathons_event_time_pair_check": {
          "name": "hackathons_event_time_pair_check",
          "value": "(\"hackathons\".\"event_start\" is null and \"hackathons\".\"event_end\" is null) or (\"hackathons\".\"event_start\" is not null and \"hackathons\".\"event_end\" is not null and \"hackathons\".\"event_end\" > \"hackathons\".\"event_start\")"
        },
        "hackathons_devices_adjustment_check": {
          "name": "hackathons_devices_adjustment_check",
          "value": "\"hackathons\".\"devices_adjustment\" = case when \"hackathons\".\"device_provision\" = 'needed' then \"hackathons\".\"device_count\" * 150 else 0 end"
        }
      },
      "isRLSEnabled": false
    },
